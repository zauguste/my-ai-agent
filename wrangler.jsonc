 {                                                                 
      "$schema": "node_modules/wrangler/config-schema.json",          
      "name": "my-ai-agent",                                          
      "main": "src/index.ts",                                         
      "compatibility_date": "2025-01-01",
      "compatibility_flags": ["nodejs_compat"],
      "observability": {                                              
        "enabled": true                                               
      },                                                              
                                                                      
      // 1. Bind Workers AI so we can generate text                   
      "ai": {                                                         
        "binding": "AI"                                               
      },                             
	  // Add binding for browser
	  "browser": {
		"binding": "MYBROWSER"
	  },                                 
                                                                      
      // 2. Bind the Durable Object for the Agent's memory            
      "durable_objects": {                                            
        "bindings": [                                                 
          {                                                           
            "name": "MY_AGENT",                                       
            "class_name": "MyCustomAgent"                             
          }                                                           
        ]                                                             
      },                                                              
                                                                      
      // 3. Setup the migration for the Durable Object                
      "migrations": [                                                 
        {                                                             
          "tag": "v1",                                                
          "new_sqlite_classes": ["MyCustomAgent"]                            
        }                                                             
      ]                                                               
    }